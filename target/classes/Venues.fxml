<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="680.0" prefWidth="1080.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.VenuesController">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="database-header">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="page-title" text="Cities and Stadiums" />
                                <Label styleClass="phase-label" text="Manage the PostgreSQL venues used during the knockout stage" />
                            </children>
                        </VBox>
                        <Button onAction="#handleBack" prefWidth="110.0" styleClass="secondary-button" text="Back" />
                    </children>
                </HBox>
            </top>
            <center>
                <HBox spacing="16.0" styleClass="content-area">
                    <children>
                        <VBox spacing="10.0" styleClass="crud-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="section-title" text="Cities" HBox.hgrow="ALWAYS" />
                                        <Label fx:id="cityCountLabel" styleClass="record-count" text="0 cities registered" />
                                    </children>
                                </HBox>
                                <TableView fx:id="cityTable" styleClass="crud-table" VBox.vgrow="ALWAYS">
                                    <placeholder><Label text="No cities were found in PostgreSQL" /></placeholder>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="cityIdColumn" maxWidth="70.0" text="ID" />
                                        <TableColumn fx:id="cityNameColumn" text="City" />
                                        <TableColumn fx:id="cityCountryColumn" text="Country" />
                                    </columns>
                                </TableView>
                                <Label styleClass="form-label-dark" text="City name" />
                                <TextField fx:id="cityNameField" promptText="City name" styleClass="crud-field" />
                                <Label styleClass="form-label-dark" text="Country" />
                                <ComboBox fx:id="countryCombo" maxWidth="Infinity" promptText="Select country" styleClass="crud-field" />
                                <HBox alignment="CENTER" spacing="8.0" styleClass="crud-actions">
                                    <children>
                                        <Button onAction="#handleAddCity" styleClass="custom-button" text="Add" />
                                        <Button fx:id="updateCityButton" onAction="#handleUpdateCity" styleClass="custom-button" text="Update" />
                                        <Button fx:id="deleteCityButton" onAction="#handleDeleteCity" styleClass="danger-button" text="Delete" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="crud-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="section-title" text="Stadiums" HBox.hgrow="ALWAYS" />
                                        <Label fx:id="stadiumCountLabel" styleClass="record-count" text="0 stadiums available" />
                                    </children>
                                </HBox>
                                <TableView fx:id="stadiumTable" styleClass="crud-table" VBox.vgrow="ALWAYS">
                                    <placeholder><Label text="No stadiums are currently available" /></placeholder>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="stadiumIdColumn" maxWidth="70.0" text="ID" />
                                        <TableColumn fx:id="stadiumNameColumn" text="Stadium" />
                                        <TableColumn fx:id="stadiumCityColumn" text="City" />
                                    </columns>
                                </TableView>
                                <Label styleClass="form-label-dark" text="Stadium name" />
                                <TextField fx:id="stadiumNameField" promptText="Stadium name" styleClass="crud-field" />
                                <Label styleClass="form-label-dark" text="City" />
                                <ComboBox fx:id="stadiumCityCombo" maxWidth="Infinity" promptText="Select city" styleClass="crud-field" />
                                <HBox alignment="CENTER" spacing="8.0" styleClass="crud-actions">
                                    <children>
                                        <Button onAction="#handleAddStadium" styleClass="custom-button" text="Add" />
                                        <Button fx:id="updateStadiumButton" onAction="#handleUpdateStadium" styleClass="custom-button" text="Update" />
                                        <Button fx:id="deleteStadiumButton" onAction="#handleDeleteStadium" styleClass="danger-button" text="Delete" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
