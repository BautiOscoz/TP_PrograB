<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="tournamentPane" prefHeight="900" prefWidth="700" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.TournamentController">
    <children>
        <BorderPane prefHeight="768" prefWidth="1400">
            <left>
                <VBox prefWidth="215.0" styleClass="sidebar">
                    <children>
                        <Label alignment="TOP_CENTER" prefHeight="76.0" prefWidth="191.0" styleClass="sidebar-title" text="Tournament Simulator" textAlignment="CENTER" wrapText="true" />
                  <ImageView fitHeight="250.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@Trophy.gif" />
                     </image>
                  </ImageView>
                        <Button fx:id="groupBtn" onAction="#handleGroupStage" styleClass="menu-button" text="Group Stage" />
                        <HBox spacing="5.0" styleClass="zone-row">
                            <children>
                                <Button onAction="#handleZoneA" styleClass="zone-button" text="A" />
                                <Button onAction="#handleZoneB" styleClass="zone-button" text="B" />
                                <Button onAction="#handleZoneC" styleClass="zone-button" text="C" />
                                <Button onAction="#handleZoneD" styleClass="zone-button" text="D" />
                            </children>
                        </HBox>
                        <Button fx:id="knockoutBtn" onAction="#handleKnockoutStage" styleClass="menu-button" text="Knockout Stage" />
                        <Button fx:id="scorersBtn" onAction="#handleTopScorers" styleClass="menu-button" text="Top Scorers" />
                        <Button fx:id="participationBtn" onAction="#handleParticipation" styleClass="menu-button" text="Participation Ranking" />
                        <Button fx:id="fairplayBtn" onAction="#handleFairPlay" styleClass="menu-button" text="Fair Play" />
                        <Button fx:id="teamStBtn" onAction="#handleTeamsStats" styleClass="menu-button" text="Teams Stats" />
                        <Button fx:id="playerStBtn" onAction="#handlePlayersStats" styleClass="menu-button" text="Players Stats" />
                        <Button fx:id="refereesStBtn" onAction="#handleRefereesStats" styleClass="menu-button" text="Referees Stats" />
                        <Button fx:id="knockoutBtn1" onAction="#handleKnockoutStage" styleClass="menu-button" text="Cities/Stadiums CRUD" />
                        <Button fx:id="getIDBtn" onAction="#handleGetIdentifications" styleClass="menu-button" text="Get Identifications" />
                        <Button fx:id="backBtn" onAction="#handleBack" styleClass="secondary-button" text="Back" />
                    </children>
                </VBox>
            </left>
            <center>
                <VBox spacing="14.0" styleClass="content-area">
                    <children>
                        <HBox alignment="CENTER_LEFT" styleClass="page-header">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label fx:id="tournamentNameLabel" styleClass="page-title" text="Tournament" />
                                        <Label fx:id="phaseLabel" styleClass="phase-label" text="Group Stage" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label fx:id="zoneTitleLabel" styleClass="section-title" text="Zone A" />
                            </children>
                        </HBox>
                        <TableView fx:id="standingsTable" maxHeight="124" maxWidth="700" prefWidth="776.0" styleClass="standings-table" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="positionColumn" prefWidth="45.0" text="#" />
                                <TableColumn fx:id="teamColumn" prefWidth="220.0" text="Team" />
                                <TableColumn fx:id="pointsColumn" prefWidth="55.0" text="PTS" />
                                <TableColumn fx:id="playedColumn" prefWidth="55.0" text="PJ" />
                                <TableColumn fx:id="wonColumn" prefWidth="55.0" text="PG" />
                                <TableColumn fx:id="drawnColumn" prefWidth="55.0" text="PE" />
                                <TableColumn fx:id="lostColumn" prefWidth="55.0" text="PP" />
                                <TableColumn fx:id="goalsForColumn" prefWidth="55.0" text="GF" />
                                <TableColumn fx:id="goalsAgainstColumn" prefWidth="55.0" text="GC" />
                                <TableColumn fx:id="differenceColumn" prefWidth="55.0" text="DG" />
                            </columns>
                        </TableView>
                        <VBox fx:id="knockoutBracket" minHeight="600" spacing="10.0" styleClass="knockout-bracket" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER" spacing="10.0" styleClass="round-header-row">
                                    <children>
                                        <Label minWidth="170.0" styleClass="round-title" text="CUARTOS" />
                                        <Label minWidth="28.0" text="" />
                                        <Label minWidth="170.0" styleClass="round-title" text="SEMIFINALES" />
                                        <Label minWidth="28.0" text="" />
                                        <Label minWidth="170.0" styleClass="round-title" text="FINAL" />
                                    </children>
                                </HBox>
                                <HBox fx:id="bracketContent" alignment="CENTER" prefWidth="779.0" spacing="10.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox fx:id="quarterColumn" maxWidth="170.0" prefWidth="170.0" spacing="8.0" styleClass="bracket-column" />
                                        <VBox fx:id="quarterConnectorColumn" alignment="CENTER" maxWidth="28.0" prefWidth="28.0" styleClass="connector-column" />
                                        <VBox fx:id="semiColumn" maxWidth="170.0" prefWidth="170.0" spacing="8.0" styleClass="bracket-column" />
                                        <VBox fx:id="semiConnectorColumn" alignment="CENTER" maxWidth="28.0" prefWidth="28.0" styleClass="connector-column" />
                                        <VBox fx:id="finalColumn" alignment="CENTER" maxWidth="170.0" prefWidth="170.0" spacing="8.0" styleClass="bracket-column" />
                                    </children>
                                </HBox>
                                <Label fx:id="winnerBanner" alignment="CENTER" maxWidth="Infinity" styleClass="winner-banner" text="GANADOR: -" />
                            </children>
                        </VBox>
                        <TextArea fx:id="reportArea" styleClass="report-area" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
